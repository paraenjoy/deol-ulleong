<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- AAOS 차속 (dangerous: 런타임 요청 필요) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <!-- Pleos Vehicle SDK (에뮬레이터에서 모두 prot=normal 확인) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />          <!-- 조향각 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />         <!-- 엠비언트 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />        <!-- 공조 읽기 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" /><!-- 공조 쓰기 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />          <!-- 탑승 감지 -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- 덤: NaviHelper -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" /> <!-- requestRoute, cancelRoute -->

    <application
        android:allowBackup="false"
        android:label="MotionCare Spike"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- 주행 중 허용 화면(DO) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!-- 비교용: distractionOptimized 없음 -->
        <activity
            android:name=".PlainActivity"
            android:exported="true" />
    </application>
</manifest>
